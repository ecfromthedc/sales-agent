# rt-carousel-agent — environment template
# Copy to .env and fill in. .env is gitignored.

# REQUIRED FOR FULL PIPELINE
# Anthropic API key for hybrid generation (LLM fills gaps in Eric's intake).
# Currently Eric has ANTHROPIC_API_KEY commented out in ~/.zshrc — uncomment or set here.
ANTHROPIC_API_KEY=

# Slack bot token for posting PNGs back to the brief thread.
# Already exists at ~/.cortextos/default/eric-claude-bot.env — Config loader reads it automatically.
# Override only if you want to use a different bot here.
# SLACK_BOT_TOKEN=

# OPTIONAL — overrides
# RT_CAROUSEL_BIND=127.0.0.1:7677
# RT_CAROUSEL_SLACK_CHANNEL=C0B5X88QQ0K
# RT_CAROUSEL_REPO=/Users/ericcromartie/Documents/Development/carousels-agent
# RT_NEO4J_SEARCH_ENDPOINT=http://127.0.0.1:7474
# RUST_LOG=info,rt_carousel_agent=debug
